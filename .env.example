# Deliver contact form to this inbox
CONTACT_TO=eloprepotchy@gmail.com
CONTACT_FROM_NAME=Portfolio Contact Form

# Resend API (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx
# Until you verify a custom domain, use onboarding@resend.dev
CONTACT_FROM=onboarding@resend.dev

# Optional chat (Gemini). Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Private contract studio at /studio (Ctrl+Shift+A). Never commit the real password.
CONTRACT_PASS=

# Google Calendar (Schedule a call). Never commit the JSON key.
GOOGLE_CALENDAR_ID=eloprepotchy@gmail.com
GOOGLE_APPLICATION_CREDENTIALS=Calendar/your-service-account.json
# On Render, paste the JSON as one line instead of a file:
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Meet (OAuth as Jhon). Never commit the secret or refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://127.0.0.1:3000/api/calendar/oauth/callback
# After you open /api/calendar/oauth?pass=YOUR_CONTRACT_PASS once:
# GOOGLE_OAUTH_REFRESH_TOKEN=
